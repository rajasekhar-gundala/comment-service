---
interface Props {
  slug: string;
  apiBaseUrl?: string;
}

const { slug, apiBaseUrl = "https://comments.yourdomain.com" } = Astro.props;
---

<section class="mt-12 border-t border-neutral-200 dark:border-neutral-800 pt-8">
  <h3 class="text-2xl font-bold mb-6 text-neutral-900 dark:text-neutral-100">Discussion</h3>

  <!-- Comments Container -->
  <div 
    id="comments-list" 
    hx-get={`${apiBaseUrl}/api/comments?slug=${slug}`} 
    hx-trigger="load" 
    hx-swap="innerHTML"
    class="space-y-4 mb-8"
  >
    <div class="text-neutral-400 text-sm animate-pulse">Loading comments...</div>
  </div>

  <!-- Submission Form -->
  <form 
    hx-post={`${apiBaseUrl}/api/comments`} 
    hx-target="#comments-list" 
    hx-swap="beforeend" 
    hx-on::after-request="if(event.detail.successful) this.reset()"
    class="space-y-4 max-w-xl"
  >
    <input type="hidden" name="post_slug" value={slug} />

    <!-- Spam trap honeypot field -->
    <input type="text" name="honeypot" style="display:none !important" tabindex="-1" autocomplete="off" />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold mb-1 text-neutral-600 dark:text-neutral-400">Name *</label>
        <input 
          type="text" 
          name="author_name" 
          required 
          placeholder="Jane Doe" 
          class="w-full px-3.5 py-2 bg-neutral-50 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 rounded-lg text-sm outline-none focus:ring-2 focus:ring-emerald-500" 
        />
      </div>
      <div>
        <label class="block text-xs font-semibold mb-1 text-neutral-600 dark:text-neutral-400">Email (Optional)</label>
        <input 
          type="email" 
          name="author_email" 
          placeholder="jane@example.com" 
          class="w-full px-3.5 py-2 bg-neutral-50 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 rounded-lg text-sm outline-none focus:ring-2 focus:ring-emerald-500" 
        />
      </div>
    </div>

    <div>
      <label class="block text-xs font-semibold mb-1 text-neutral-600 dark:text-neutral-400">Comment *</label>
      <textarea 
        name="content" 
        rows="3" 
        required 
        placeholder="Write a comment..." 
        class="w-full px-3.5 py-2 bg-neutral-50 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 rounded-lg text-sm outline-none focus:ring-2 focus:ring-emerald-500"
      ></textarea>
    </div>

    <button 
      type="submit" 
      class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-lg text-sm transition-colors shadow-sm"
    >
      Post Comment
    </button>
  </form>
</section>

<!-- Ensure HTMX is available if not globally present in Layout -->
<script src="https://unpkg.com/htmx.org@1.9.12" is:inline></script>